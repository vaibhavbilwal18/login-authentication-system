    "description": "Backend Login API with Node.js, Express, and TypeScript",
    "main": "dist/server.js",
    "scripts": {
          "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
          "build": "tsc",
          "start": "node dist/server.js"
